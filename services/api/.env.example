# services/api — copy to services/api/.env (or use the root .env). Never commit real values.
DATABASE_URL=postgres://faze:faze@localhost:5432/faze
JWT_SECRET=                 # any long random string; shared with services/payments
INTERNAL_SECRET=            # shared with services/payments (X-Internal-Secret header)
PORT=4000
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001   # client, admin (CORS with credentials)
