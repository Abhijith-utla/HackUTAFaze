# Copy to .env. Never commit real values.
# Local docker default. For managed Postgres (e.g. Tiger Cloud, pending lead decision) use its URL with ?sslmode=require.
DATABASE_URL=postgres://faze:faze@localhost:5432/faze_dev
JWT_SECRET=
INTERNAL_SECRET=              # shared by services/api and services/payments
API_URL=http://localhost:4000
PAYMENTS_URL=http://localhost:4100
CLIENT_URL=http://localhost:3000
PAYMENTS_PORT=4100
PAYMENTS_STANDALONE=0         # 1 = payments runs without Postgres/API (in-memory)
SOLANA_CLUSTER=devnet         # devnet | testnet | localnet — mainnet is refused
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_PUBKEY=       # PUBLIC key of the devnet wallet that receives payments (no private key needed)
PAYMENTS_SIMULATE=0           # 1 = test-only simulated chain (signatures sim_<reference>_<lamports>); refused in production
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
ENGAGEMENT_SIM_INTERVAL_SECONDS=30

# Isolated integration-test database (must differ from DATABASE_URL); never production.
TEST_DATABASE_URL=postgres://faze:faze@localhost:5432/faze

# Browser API origin (public); API CORS must allow both frontends.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PAYMENTS_URL=http://localhost:4100
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
# Server-only durable artwork location; default .data/uploads at repository root.
UPLOAD_DIR=
PAYMENT_RECONCILE_INTERVAL_SECONDS=15

# services/api art + seed (optional overrides)
PUBLIC_API_URL=               # absolute base for artUrl if clients reach the API at a different URL (defaults to API_URL)
ART_DIR=                      # legacy upload dir (UPLOAD_DIR takes precedence)
DEMO_ART_DIR=                 # committed seed art dir (default content/seed/art)
SEED_CATALOG=                 # catalog JSON for npm run seed (default content/seed/catalog.json)

# Browser + client
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com   # client-side RPC for Phantom checkout (devnet only)

# Control Room (lead, optional)
ARCHIVE_FILE=                 # default content/archive/faze-timeline.json
OLLAMA_URL=                   # e.g. http://localhost:11434 — local model rewrites card lore; blank = archive-grounded template writer
OLLAMA_MODEL=llama3.2

# Server-side pack SOL price per existing pack pricing unit; 100 units = 0.005 SOL.
PACK_LAMPORTS_PER_COIN=50000

# Twitch Helix (optional; GET /twitch/live and the header LIVE pill). Create an app at https://dev.twitch.tv/console
# (Client Type: Confidential, any https OAuth redirect such as https://localhost). Never commit real values.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=faze
